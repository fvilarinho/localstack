{
  "resources": {
    "iam": {
      "role": "lambda",
      "policy": {
        "name": "lambda-my-dynamodb-table",
        "actions": [
          "PutItem",
          "DeleteItem",
          "Scan"
        ]
      }
    },
    "s3": {
      "bucket": "my-bucket",
      "notification": {
        "lambda": {
          "function": "my-lambda"
        },
        "events": [
          "ObjectRemoved",
          "ObjectCreated"
        ]
      }
    },
    "lambda": [
      {
        "function": "my-lambda",
        "role": "lambda"
      },
      {
        "function": "my-dynamodb-table",
        "role": "lambda"
      }
    ],
    "dynamodb": {
      "table": "my-dynamodb-table"
    },
    "apigateway": {
      "name": "my-api",
      "path": "/get_items",
      "method": "GET",
      "lambda": {
        "function": "my-dynamodb-table"
      }
    }
  }
}